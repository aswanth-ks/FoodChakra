# Copy to `backend/.env` and fill in real values. NEVER commit the .env file.

APP_NAME=FoodLoop API
ENVIRONMENT=local
DEBUG=true

# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=foodloop

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-48-byte-url-safe-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated. 5173 = Vite dashboard, 8080 = Flutter web dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
