# Copy to `backend/.env` and fill in real values. NEVER commit the .env file.

APP_NAME=FoodLoop API
ENVIRONMENT=local
DEBUG=true

# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=foodloop

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-48-byte-url-safe-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated. 5173 = Vite dashboard, 8080 = Flutter web dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ----- External services -----
# Optional. Nothing reads this until the maps/geocoding work; leave blank until
# then. Restrict the key to the APIs and referrers you actually use.
GOOGLE_MAPS_API_KEY=

# ----- Email (SMTP) -----
# Required for account verification, password reset and the sign-in
# confirmation email. Leave SMTP_HOST blank to disable outbound mail: the API
# then answers 503 SERVICE_UNAVAILABLE on those endpoints rather than
# pretending a code was sent.
#
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and use it as SMTP_PASSWORD.
# A normal account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your smtp username / sending address>
SMTP_PASSWORD=<app password — NEVER commit a real one>
SMTP_FROM_EMAIL=<sending address>
SMTP_FROM_NAME=FoodLoop
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# ----- One-time codes -----
# Applies to both email verification and password reset.
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
